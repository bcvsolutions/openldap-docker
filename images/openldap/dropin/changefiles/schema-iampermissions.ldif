# ----- LDIF HEADER BEGIN -----
# header-version: 1
# apply-context: config
# dn-lookup: (&(objectClass=olcSchemaConfig)(cn={*}iamManagedUser))
# ----- LDIF HEADER END -----

dn: cn={14}iamManagedUser,cn=schema,cn=config
changetype: modify
add: olcAttributeTypes
olcAttributeTypes: {0}(
  1.3.6.1.4.1.33537.1.2.2.3
  NAME 'iamPermissions'
  EQUALITY caseIgnoreMatch
  DESC 'Multivalued list of users roles'
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
  )
-
replace: olcObjectClasses
olcObjectClasses: {0}(
  1.3.6.1.4.1.33537.1.2.1.1
  NAME 'iamManagedUser'
  DESC 'IAM appliance-managed user account'
  SUP top
  AUXILIARY
  MAY ( iamUserStatus $ iamPermissions )
  X-ORIGIN 'IAM appliance analogy of inetUser' )
